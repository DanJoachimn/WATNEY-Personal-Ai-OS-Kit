<?xml version="1.0" encoding="UTF-8"?>
<!--
  Health-check launchd job template — Partner AI Kit

  The deadman switch for [AI_NAME]'s background jobs. Runs DAILY, on pure
  /bin/bash — no Python, no venv, no `claude` call.

  ⚠️ DO NOT change ProgramArguments to python3 or to `claude -p`. This job exists
  to notice when those things break. If it runs on the same substrate it watches,
  it dies alongside them and you learn nothing — which is exactly the outage that
  caused this script to be written. See health-check.sh's header.

  setup.sh renders and loads this automatically. To do it by hand, replace [USER]
  with the macOS username and [AI_NAME] with the lowercase AI name, then:
    launchctl load ~/Library/LaunchAgents/com.[user].[ai-name].health-check.plist
    launchctl list | grep health-check      # must return a row

  No Full Disk Access needed — deliberately. The script reads only unprotected
  paths under ~/[ai-name]/ so that no permission change can ever silence it.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.[USER].[AI_NAME].health-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/[USER]/.claude/skills/health-check/health-check.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/[USER]</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/[USER]/[AI_NAME]/logs/health-check.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/[USER]/[AI_NAME]/logs/health-check.err</string>
</dict>
</plist>
