{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How the Obsidian LLM wiki works",
    "locale": "en",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "feed-it",
        "label": "Feed it",
        "focus": [
          "clip",
          "clippings",
          "ingest",
          "wiki",
          "overview"
        ],
        "note": "You pick what's worth keeping. Your AI reads it once, files it into linked pages and updates the overview."
      },
      {
        "id": "ask-it",
        "label": "Ask it",
        "focus": [
          "ask",
          "overview",
          "answer"
        ],
        "note": "Ask in your own words. Your AI starts from the overview and answers with links to the pages it used."
      },
      {
        "id": "it-compounds",
        "label": "It compounds",
        "focus": [
          "answer",
          "explore",
          "wiki"
        ],
        "note": "Good answers are saved as pages too, so next month's question starts from a smarter wiki."
      }
    ],
    "legend": {
      "mode": "hidden"
    },
    "viewBox": [
      1000,
      528
    ]
  },
  "lanes": [
    {
      "id": "you",
      "label": "You"
    },
    {
      "id": "ai",
      "label": "Your AI"
    },
    {
      "id": "vault",
      "label": "Your vault"
    }
  ],
  "mainPath": [
    "clip",
    "clippings",
    "ingest",
    "wiki",
    "overview",
    "answer",
    "explore"
  ],
